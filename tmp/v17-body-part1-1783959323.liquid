    <script>
    function nwFilter(cat, btn) {
        document.querySelectorAll('#nwGrid > div').forEach(el => {
            const cats = el.getAttribute('data-cat') || '';
            el.style.display = cats.includes(cat) ? '' : 'none';
        });
        document.querySelectorAll('[onclick^="nwFilter"]').forEach(b => {
            b.style.borderBottomColor = 'transparent';
            b.style.color = 'var(--text-light)';
        });
        btn.style.borderBottomColor = 'var(--charcoal)';
        btn.style.color = 'var(--charcoal)';
    }
    </script>


