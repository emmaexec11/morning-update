{% comment %}
  Wyld Editorial Product Page — matches v17 homepage aesthetic
  Cream + forest green + dusty rose palette, slide-fill buttons, editorial typography
  Renders product info from Shopify Liquid context + product.description for custom content per product
{% endcomment %}

{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
  assign has_compare_price = false
  if current_variant.compare_at_price > current_variant.price
    assign has_compare_price = true
    assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}

<style>
  .wyld-pdp {
    background: var(--wyld-cream, #FAF6EE);
    color: var(--wyld-ink, #1F1B17);
    font-family: var(--font-body-family, 'Jost', sans-serif);
  }
  .wyld-pdp__container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 40px 40px 80px;
  }
  /* --- HERO --- */
  .wyld-pdp__hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: start;
    padding: 32px 0 56px;
  }
  @media (max-width: 900px) {
    .wyld-pdp__hero { grid-template-columns: 1fr; gap: 32px; }
    .wyld-pdp__container { padding: 24px 20px 60px; }
  }
  /* ============================
     GALLERY — Saie/RMS pattern
     Desktop: thumbnail strip LEFT (vertical), hero RIGHT
     Mobile: swipeable carousel full-width, dots below
     ============================ */
  .wyld-pdp__gallery {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 16px;
    align-items: start;
  }
  .wyld-pdp__thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 640px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(195,194,174,0.5) transparent;
  }
  .wyld-pdp__thumbs::-webkit-scrollbar { width: 4px; }
  .wyld-pdp__thumbs::-webkit-scrollbar-thumb { background: rgba(195,194,174,0.5); border-radius: 2px; }
  .wyld-pdp__thumb {
    aspect-ratio: 1/1;
    width: 92px;
    background: var(--wyld-cream-warm, #F0EAD8);
    overflow: hidden;
    border: 1px solid rgba(195,194,174,0.4);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: border-color 220ms ease, opacity 220ms ease;
    opacity: 0.65;
  }
  .wyld-pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wyld-pdp__thumb:hover { opacity: 0.85; border-color: rgba(154,107,101,0.6); }
  .wyld-pdp__thumb.is-active { opacity: 1; border-color: var(--wyld-ink, #1F1B17); }

  /* Hero on right (desktop) */
  .wyld-pdp__main {
    position: relative;
    width: 100%;
  }
  .wyld-pdp__main-img {
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--wyld-cream-warm, #F0EAD8);
    overflow: hidden;
    position: relative;
  }
  .wyld-pdp__main-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mobile carousel (≤900px): swipeable, dots below */
  .wyld-pdp__dots { display: none; }
  @media (max-width: 900px) {
    /* CRITICAL: Stop the entire PDP from causing page-level horizontal scroll */
    html, body { overflow-x: hidden !important; max-width: 100vw; }
    .wyld-pdp,
    .wyld-pdp__container,
    .wyld-pdp__hero {
      max-width: 100%;
      overflow-x: hidden;
    }
    /* Belt + suspenders for any inline-styled section that might overflow */
    .wyld-pdp section { max-width: 100vw; overflow-x: hidden; }
    .wyld-pdp__gallery {
      grid-template-columns: 1fr;
      gap: 14px;
      max-width: 100%;
      min-width: 0;
    }
    .wyld-pdp__thumbs {
      display: none;
    }
    .wyld-pdp__main {
      display: flex;
      overflow-x: auto;
      max-width: 100%;
      min-width: 0;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      gap: 0;
      scroll-behavior: smooth;
    }
    .wyld-pdp__main::-webkit-scrollbar { display: none; }
    .wyld-pdp__main-img {
      flex: 0 0 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      aspect-ratio: 1/1;
    }
    .wyld-pdp__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 6px;
    }
    .wyld-pdp__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(31,27,23,0.25);
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 220ms ease, transform 220ms ease;
    }
    .wyld-pdp__dot.is-active {
      background: var(--wyld-ink, #1F1B17);
      transform: scale(1.15);
    }
  }

  /* --- INFO COLUMN --- */
  .wyld-pdp__info {
    position: sticky;
    top: 100px;
    padding-top: 8px;
  }
  .wyld-pdp__eyebrow {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--wyld-rose, #9A6B65);
    margin-bottom: 16px;
  }
  .wyld-pdp__title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 400;
    line-height: 1.08;
    color: var(--wyld-ink, #1F1B17);
    margin: 0 0 18px;
    letter-spacing: -0.015em;
  }
  .wyld-pdp__rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }
  .wyld-pdp__stars {
    color: var(--wyld-rose, #9A6B65);
    font-size: 16px;
    letter-spacing: 0.8px;
  }
  .wyld-pdp__review-count {
    font-size: 12px;
    color: var(--wyld-stone, #5F574D);
    text-decoration: none;
    border-bottom: 1px solid rgba(95,87,77,0.35);
    padding-bottom: 1px;
    letter-spacing: 0.02em;
  }
  .wyld-pdp__review-count:hover { color: var(--wyld-rose, #9A6B65); border-bottom-color: var(--wyld-rose, #9A6B65); }
  .wyld-pdp__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }
  .wyld-pdp__price {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 30px;
    font-weight: 400;
    color: var(--wyld-ink, #1F1B17);
    letter-spacing: -0.005em;
  }
  .wyld-pdp__compare {
    font-size: 17px;
    text-decoration: line-through;
    color: var(--wyld-stone, #5F574D);
    font-weight: 300;
  }
  /* --- STICKY ATC BAR (appears on scroll past hero) --- */
  .wyld-pdp__sticky-atc {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: var(--wyld-cream, #FAF6EE);
    border-bottom: 1px solid rgba(195,194,174,0.5);
    box-shadow: 0 1px 12px rgba(31,27,23,0.04);
    transform: translateY(-100%);
    transition: transform 380ms cubic-bezier(.22,.61,.36,1);
  }
  .wyld-pdp__sticky-atc.is-visible { transform: translateY(0); }
  .wyld-pdp__sticky-atc-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 12px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .wyld-pdp__sticky-atc-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .wyld-pdp__sticky-atc-meta img {
    width: 48px; height: 48px;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }
  .wyld-pdp__sticky-atc-title {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 17px;
    font-weight: 400;
    color: var(--wyld-ink, #1F1B17);
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .wyld-pdp__sticky-atc-price {
    font-size: 13px;
    color: var(--wyld-stone, #5F574D);
    font-weight: 500;
    margin-top: 2px;
  }
  .wyld-pdp__sticky-atc-form { margin: 0; flex-shrink: 0; }
  body form[action*="/cart/add"] button.wyld-pdp__sticky-atc-btn,
  body button.wyld-pdp__sticky-atc-btn {
    background: #2E332C !important;
    background-color: #2E332C !important;
    background-image: none !important;
    color: #FAF6EE !important;
    border: 1px solid #2E332C !important;
    padding: 12px 26px !important;
    font-family: var(--font-subheading-family, 'Jost', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 220ms ease, transform 220ms ease;
  }
  body form[action*="/cart/add"] button.wyld-pdp__sticky-atc-btn:hover,
  body button.wyld-pdp__sticky-atc-btn:hover {
    background: #1F2419 !important;
    background-color: #1F2419 !important;
    color: #FAF6EE !important;
    transform: translateY(-1px);
  }
  @media (max-width: 900px) {
    /* Mobile: sticky ATC slides up from BOTTOM (thumb reach) */
    .wyld-pdp__sticky-atc {
      top: auto;
      bottom: 0;
      border-bottom: none;
      border-top: 1px solid rgba(195,194,174,0.5);
      box-shadow: 0 -2px 16px rgba(31,27,23,0.08);
      transform: translateY(100%);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .wyld-pdp__sticky-atc-inner { padding: 10px 16px; gap: 12px; }
    .wyld-pdp__sticky-atc-meta img { width: 40px; height: 40px; }
    .wyld-pdp__sticky-atc-title { font-size: 14px; }
    .wyld-pdp__sticky-atc-price { font-size: 12px; }
    .wyld-pdp__sticky-atc-btn { padding: 12px 22px; font-size: 10px; }
  }

  .wyld-pdp__ltv-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    margin: -8px 0 22px;
  }
  .wyld-pdp__ltv-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: var(--wyld-ink-soft, #2C2620);
    letter-spacing: 0.01em;
    font-weight: 400;
  }
  .wyld-pdp__ltv-chip strong { color: var(--wyld-rose, #9A6B65); font-weight: 600; }
  .wyld-pdp__ltv-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    background: var(--wyld-cream-warm, #F0EAD8);
    color: var(--wyld-rose, #9A6B65);
    border-radius: 50%;
    font-size: 11px;
    line-height: 1;
  }
  .wyld-pdp__ltv-chip--muted { color: var(--wyld-stone, #5F574D); }
  .wyld-pdp__ltv-chip--muted .wyld-pdp__ltv-chip-icon { color: var(--wyld-stone, #5F574D); }

  .wyld-pdp__discount-badge {
    background: var(--wyld-terracotta, #9C5259);
    color: var(--wyld-cream, #FAF6EE);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    padding: 4px 10px;
    margin-left: 4px;
  }
  .wyld-pdp__short-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--wyld-ink-soft, #2C2620);
    margin-bottom: 28px;
    max-width: 480px;
  }
  /* --- VARIANT PICKER --- */
  .wyld-pdp__variants {
    margin-bottom: 24px;
  }
  .wyld-pdp__variant-label {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wyld-stone, #5F574D);
    margin-bottom: 12px;
  }
  .wyld-pdp__variant-label strong { color: var(--wyld-ink, #1F1B17); font-weight: 600; }
  .wyld-pdp__variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .wyld-pdp__variant-btn {
    background: transparent;
    border: 1px solid rgba(195,194,174,0.7);
    color: var(--wyld-ink, #1F1B17);
    padding: 11px 22px;
    font-family: var(--font-subheading-family, 'Jost', sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 220ms ease, color 220ms ease, background 220ms ease;
  }
  .wyld-pdp__variant-btn.is-active {
    background: transparent;
    color: var(--wyld-ink, #1F1B17);
    border-color: var(--wyld-ink, #1F1B17);
  }
  .wyld-pdp__variant-btn:hover {
    background: transparent;
    color: var(--wyld-ink, #1F1B17);
    border-color: var(--wyld-rose, #9A6B65);
  }
  .wyld-pdp__variant-btn.is-unavailable {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  /* --- PURCHASE OPTIONS (subscription vs one-time) — minimal editorial --- */
  .wyld-pdp__purchase {
    border: none;
    background: transparent;
    padding: 0;
    margin-bottom: 20px;
  }
  .wyld-pdp__purchase-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    border-bottom: 1px solid rgba(195,194,174,0.5);
    cursor: pointer;
    transition: opacity 220ms ease;
  }
  .wyld-pdp__purchase-option:first-child { border-top: 1px solid rgba(195,194,174,0.5); }
  .wyld-pdp__purchase-option:last-child {
    border-bottom: 1px solid rgba(195,194,174,0.5);
  }
  .wyld-pdp__purchase-option.is-active {
    background: transparent;
    box-shadow: none;
  }
  .wyld-pdp__purchase-option:not(.is-active) { opacity: 0.65; }
  .wyld-pdp__purchase-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .wyld-pdp__purchase-radio {
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--wyld-ink, #1F1B17);
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }
  .wyld-pdp__purchase-option.is-active .wyld-pdp__purchase-radio::after {
    content: '';
    position: absolute;
    inset: 3px;
    background: var(--wyld-ink, #1F1B17);
    border-radius: 50%;
  }
  .wyld-pdp__purchase-label {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--wyld-ink, #1F1B17);
    letter-spacing: 0.005em;
  }
  .wyld-pdp__purchase-sub {
    font-size: 11.5px;
    color: var(--wyld-stone, #5F574D);
    margin-top: 3px;
    font-weight: 300;
  }
  .wyld-pdp__purchase-price {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 18px;
    font-weight: 400;
    color: var(--wyld-ink, #1F1B17);
    letter-spacing: -0.005em;
  }
  .wyld-pdp__sub-savings {
    background: transparent;
    color: var(--wyld-rose, #9A6B65);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    padding: 0;
    margin-left: 10px;
    border-bottom: 1px solid var(--wyld-rose, #9A6B65);
    padding-bottom: 1px;
  }

  /* --- ADD TO CART --- */
  /* Specificity-bumped to beat Horizon's form[action*="/cart/add"] button override */
  body .wyld-pdp form[action*="/cart/add"] button.wyld-pdp__atc,
  body .wyld-pdp button.wyld-pdp__atc,
  body button.wyld-pdp__atc {
    display: block !important;
    width: 100% !important;
    background: #2E332C !important;
    background-color: #2E332C !important;
    background-image: none !important;
    color: #FAF6EE !important;
    border: 1px solid #2E332C !important;
    padding: 18px 32px !important;
    font-family: var(--font-subheading-family, 'Jost', sans-serif);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: transform 220ms cubic-bezier(.22,.61,.36,1), box-shadow 220ms cubic-bezier(.22,.61,.36,1), background-color 220ms ease;
    margin-bottom: 16px;
  }
  body .wyld-pdp form[action*="/cart/add"] button.wyld-pdp__atc:hover,
  body .wyld-pdp button.wyld-pdp__atc:hover,
  body button.wyld-pdp__atc:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(31,27,23,0.16) !important;
    background: #1F2419 !important;
    background-color: #1F2419 !important;
    color: #FAF6EE !important;
  }
  .wyld-pdp__atc[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* --- TRUST BAR — minimal text strip, no box --- */
  .wyld-pdp__trust-bar {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 28px;
    padding: 16px 0;
    background: transparent;
    border-top: 1px solid rgba(195,194,174,0.5);
    border-bottom: 1px solid rgba(195,194,174,0.5);
    margin-bottom: 24px;
  }
  .wyld-pdp__trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
  .wyld-pdp__trust-icon {
    width: 14px;
    height: 14px;
    color: var(--wyld-rose, #9A6B65);
    flex-shrink: 0;
    opacity: 0.85;
  }
  .wyld-pdp__trust-text {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--wyld-stone, #5F574D);
    line-height: 1.3;
  }

  /* --- BUNDLE UPSELL — editorial, light --- */
  .wyld-pdp__bundle-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    background: var(--wyld-cream-warm, #F0EAD8);
    color: var(--wyld-ink, #1F1B17);
    margin-bottom: 28px;
    cursor: pointer;
    text-decoration: none;
    transition: background 220ms ease;
    border: 1px solid rgba(195,194,174,0.4);
  }
  .wyld-pdp__bundle-card:hover {
    background: #E8DFCA;
  }
  .wyld-pdp__bundle-icon {
    width: 36px;
    height: 36px;
    background: rgba(154,107,101,0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: var(--wyld-rose, #9A6B65);
    flex-shrink: 0;
  }
  .wyld-pdp__bundle-text {
    flex: 1;
  }
  .wyld-pdp__bundle-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--wyld-rose, #9A6B65);
    margin-bottom: 5px;
  }
  .wyld-pdp__bundle-headline {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 17px;
    font-weight: 400;
    color: var(--wyld-ink, #1F1B17);
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  .wyld-pdp__bundle-arrow {
    color: var(--wyld-ink, #1F1B17);
    font-size: 18px;
  }

  /* --- RICH DESCRIPTION BLOCK --- */
  .wyld-pdp__rich-section {
    padding: 64px 0 48px;
    border-top: 1px solid rgba(195,194,174,0.4);
  }
  .wyld-pdp__rich-section h2,
  .wyld-pdp__rich-section h3 {
    font-family: var(--font-heading-family, 'Cormorant Garamond', serif);
    font-weight: 400;
    color: var(--wyld-ink, #1F1B17);
    line-height: 1.2;
  }
  .wyld-pdp__rich-section h2 { font-size: clamp(26px, 2.8vw, 36px); margin: 0 0 16px; }
  .wyld-pdp__rich-section h3 { font-size: clamp(20px, 1.8vw, 24px); margin: 24px 0 12px; }
  .wyld-pdp__rich-section p,
  .wyld-pdp__rich-section li {
    font-size: 15px;
    line-height: 1.7;
    color: var(--wyld-ink-soft, #2C2620);
    margin-bottom: 14px;
  }
  .wyld-pdp__rich-section ul, .wyld-pdp__rich-section ol {
    padding-left: 20px;
  }
  .wyld-pdp__rich-section img {
    max-width: 100%;
    height: auto;
    margin: 24px 0;
  }
  .wyld-pdp__rich-section a {
    color: var(--wyld-rose, #9A6B65);
    text-decoration: underline;
  }

  /* --- COMPACT variant: tabs live inside right column under bundle card --- */
  .wyld-pdp__rich-section--compact {
    padding: 24px 0 0;
    border-top: none;
    margin-top: 0;
  }
  .wyld-pdp__rich-section--compact .wyld-pdp__tabs { margin: 0; }
  .wyld-pdp__rich-section--compact .wyld-pdp__tab-btn {
    padding: 14px 18px 12px;
    font-size: 10px;
    letter-spacing: 0.18em;
  }
  .wyld-pdp__rich-section--compact .wyld-pdp__tab-btn:first-child { padding-left: 0; }
  .wyld-pdp__rich-section--compact .wyld-pdp__tab-panel.is-active {
    padding: 18px 0 4px;
  }
  .wyld-pdp__rich-section--compact h2 { font-size: 18px; margin: 0 0 10px; }
  .wyld-pdp__rich-section--compact h3 { font-size: 15px; margin: 14px 0 8px; }
  .wyld-pdp__rich-section--compact p,
  .wyld-pdp__rich-section--compact li {
    font-size: 13.5px;
    line-height: 1.7;
    font-weight: 300;
    margin-bottom: 10px;
  }
  .wyld-pdp__rich-section--compact ul, .wyld-pdp__rich-section--compact ol {
    padding-left: 18px;
    margin: 8px 0;
  }
  .wyld-pdp__rich-section--compact img { margin: 14px 0; }

  /* ============================
     TABS — editorial Wyld pattern
     Desktop: horizontal tab bar with rose underline
     Mobile (≤768px): accordion (each tab collapses)
     ============================ */
  .wyld-pdp__tabs {
    margin: 40px 0 24px;
  }
  .wyld-pdp__tabs-nav {
    display: flex;
    gap: 0;
    justify-content: flex-start;
    border-bottom: 1px solid rgba(195,194,174,0.5);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-bottom: 4px;
  }
  .wyld-pdp__tabs-nav::-webkit-scrollbar { display: none; }
  .wyld-pdp__tab-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 22px 28px 20px;
    font-family: var(--font-subheading-family, 'Jost', sans-serif);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--wyld-stone, #5F574D);
    cursor: pointer;
    white-space: nowrap;
    transition: color 280ms cubic-bezier(.22,.61,.36,1), border-color 280ms cubic-bezier(.22,.61,.36,1);
    margin-bottom: -1px;
    position: relative;
  }
  .wyld-pdp__tab-btn:first-child { padding-left: 0; }
  .wyld-pdp__tab-btn:hover {
    color: var(--wyld-ink, #1F1B17);
  }
  .wyld-pdp__tab-btn.is-active {
    color: var(--wyld-ink, #1F1B17);
    border-bottom-color: var(--wyld-rose, #9A6B65);
  }

  /* Accordion toggle button — hidden on desktop, shown on mobile */
  .wyld-pdp__accordion-btn {
    display: none;
    width: 100%;
    background: transparent;
    border: none;
    border-top: 1px solid rgba(195,194,174,0.4);
    padding: 20px 0;
    font-family: var(--font-subheading-family, 'Jost', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--wyld-ink, #1F1B17);
    text-align: left;
    cursor: pointer;
    position: relative;
  }
  .wyld-pdp__accordion-btn::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    font-weight: 300;
    color: var(--wyld-rose, #9A6B65);
    transition: transform 280ms ease;
  }
  .wyld-pdp__accordion-btn.is-active::after {
    content: '−';
  }

  .wyld-pdp__tab-panel {
    display: none;
    padding: 32px 0 16px;
    animation: wyldPdpFadeIn 420ms cubic-bezier(.22,.61,.36,1);
  }
  .wyld-pdp__tab-panel.is-active {
    display: block;
  }
  @keyframes wyldPdpFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mobile: collapse to accordion */
  @media (max-width: 768px) {
    .wyld-pdp__tabs-nav { display: none; }
    .wyld-pdp__accordion-btn { display: block; }
    .wyld-pdp__tab-panel { padding: 20px 0 24px; border-bottom: 1px solid rgba(195,194,174,0.4); }
    .wyld-pdp__tabs-panels { border-bottom: 1px solid rgba(195,194,174,0.4); }
  }

  /* ============================
     MOBILE OPTIMIZATION — CUSTOM SECTIONS
     Collapses inline-style grids to single column on small screens
     ============================ */
  @media (max-width: 768px) {
    /* All split grids (1fr 1fr, 0.85fr 1fr, 1.15fr 1fr, 1fr 1.4fr, 1fr 1.6fr, 1.4fr 1fr) → single column */
    .wyld-pdp [style*="grid-template-columns:1fr 1fr"],
    .wyld-pdp [style*="grid-template-columns:0.85fr 1fr"],
    .wyld-pdp [style*="grid-template-columns:1.15fr 1fr"],
    .wyld-pdp [style*="grid-template-columns:1fr 1.4fr"],
    .wyld-pdp [style*="grid-template-columns:1fr 1.6fr"],
    .wyld-pdp [style*="grid-template-columns:1.4fr 1fr"] {
      grid-template-columns: 1fr !important;
      gap: 32px !important;
      align-items: start !important;
    }
    /* 3-col grids (testimonials, why-1, tier descriptions, how-to-use) → single column */
    .wyld-pdp [style*="grid-template-columns:repeat(3,1fr)"] {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }
    /* 4-col grid (Eight Ways) → 2 columns */
    .wyld-pdp [style*="grid-template-columns:repeat(4,1fr)"] {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 28px 16px !important;
    }
    /* 6-col & 7-col (POI chart) — keep but tighter gap and shorter height */
    .wyld-pdp [style*="grid-template-columns:repeat(6,1fr)"],
    .wyld-pdp [style*="grid-template-columns:repeat(7,1fr)"] {
      gap: 6px !important;
    }
    /* Reduce vertical padding on custom sections */
    .wyld-pdp section[style*="padding:96px"],
    .wyld-pdp section[style*="padding:120px"],
    .wyld-pdp section[style*="padding:140px"],
    .wyld-pdp section[style*="padding:160px"] {
      padding: 56px 0 !important;
    }
    /* Tighten inner horizontal padding on max-width containers */
    .wyld-pdp [style*="max-width:880px"],
    .wyld-pdp [style*="max-width:920px"],
    .wyld-pdp [style*="max-width:1100px"],
    .wyld-pdp [style*="max-width:1240px"],
    .wyld-pdp [style*="max-width:1320px"] {
      padding: 0 24px !important;
    }
    /* Shrink display headlines on mobile */
    .wyld-pdp h2[style*="clamp(28px"],
    .wyld-pdp h2[style*="clamp(32px"],
    .wyld-pdp h2[style*="clamp(34px"],
    .wyld-pdp h2[style*="clamp(38px"] {
      font-size: 30px !important;
      line-height: 1.15 !important;
    }
    /* POI chart height — shorter on mobile */
    .wyld-pdp [style*="height:300px"],
    .wyld-pdp [style*="height:260px"] {
      height: 180px !important;
    }
    .wyld-pdp [style*="height:240px"] {
      height: 160px !important;
    }
    /* Sticky-position columns don't make sense in stacked flow */
    .wyld-pdp [style*="position:sticky"] {
      position: static !important;
    }
    /* Hero PDP info column — was sticky, unstick on mobile */
    .wyld-pdp__info { position: static !important; top: auto !important; }
    /* Reduce big section internal padding (POI chart wrapper, etc) */
    .wyld-pdp [style*="padding:48px 40px"],
    .wyld-pdp [style*="padding:48px 48px"],
    .wyld-pdp [style*="padding:48px"] {
      padding: 28px 20px !important;
    }
    /* Ingredients big serif lines */
    .wyld-pdp p[style*="font-size:22px"],
    .wyld-pdp p[style*="font-size:20px"] {
      font-size: 17px !important;
    }
  }
</style>

<div class="wyld-pdp__sticky-atc" id="wyldPdpStickyAtc" aria-hidden="true">
  <div class="wyld-pdp__sticky-atc-inner">
    <div class="wyld-pdp__sticky-atc-meta">
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 120 }}" alt="" loading="lazy">
      {%- endif -%}
      <div>
        <div class="wyld-pdp__sticky-atc-title">{{ product.title | split: ' - ' | first | split: ' (' | first }}</div>
        <div class="wyld-pdp__sticky-atc-price" id="wyldPdpStickyPrice">{{ current_variant.price | money }}</div>
      </div>
    </div>
    <form method="post" action="/cart/add" enctype="multipart/form-data" novalidate class="wyld-pdp__sticky-atc-form">
      <input type="hidden" name="id" id="wyldPdpStickyVariantId" value="{{ current_variant.id }}">
      <button type="submit" class="wyld-pdp__sticky-atc-btn">Add to cart</button>
    </form>
  </div>
</div>

<div class="wyld-pdp">
  <div class="wyld-pdp__container">

    {%- comment -%} ========== HERO ROW: GALLERY + INFO ========== {%- endcomment -%}
    <div class="wyld-pdp__hero">

      {%- comment -%} --- GALLERY (Saie/RMS pattern: thumb strip left, hero right; mobile = swipeable carousel) --- {%- endcomment -%}
      <div class="wyld-pdp__gallery">
        {% if product.images.size > 1 %}
          <div class="wyld-pdp__thumbs" role="tablist" aria-label="Product images">
            {%- for img in product.images limit: 10 -%}
              <button type="button" class="wyld-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                <img src="{{ img | image_url: width: 200 }}" alt="{{ img.alt | default: product.title | escape }}" loading="lazy" width="200" height="200">
              </button>
            {%- endfor -%}
          </div>
        {% endif %}

        <div class="wyld-pdp__main" id="wyldPdpMain">
          {%- for img in product.images limit: 10 -%}
            <div class="wyld-pdp__main-img" data-index="{{ forloop.index0 }}">
              <img src="{{ img | image_url: width: 900 }}"
                   srcset="{{ img | image_url: width: 600 }} 600w,
                           {{ img | image_url: width: 900 }} 900w,
                           {{ img | image_url: width: 1200 }} 1200w"
                   sizes="(max-width: 900px) 100vw, 45vw"
                   alt="{{ img.alt | default: product.title | escape }}"
                   loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                   width="900"
                   height="900">
            </div>
          {%- endfor -%}
        </div>

        {% if product.images.size > 1 %}
          <div class="wyld-pdp__dots" role="tablist" aria-label="Gallery navigation">
            {%- for img in product.images limit: 10 -%}
              <button type="button" class="wyld-pdp__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {% endif %}
      </div>

      {%- comment -%} --- INFO (right) --- {%- endcomment -%}
      <div class="wyld-pdp__info">
        {% if product.type %}
          <span class="wyld-pdp__eyebrow">{{ product.type }}</span>
        {% endif %}

        <h1 class="wyld-pdp__title">{{ product.title | split: ' - ' | first | split: ' (' | first }}</h1>

        <div class="wyld-pdp__rating-row">
          {%- assign _pdp_rc = product.metafields.reviews.rating_count.value | plus: 0 -%}
          {%- if _pdp_rc > 0 -%}
            {% render 'wyld-judgeme-stars', product: product, size: 'large', link: '#wyld-pdp-reviews' %}
          {%- else -%}
            <a href="#wyld-pdp-reviews" class="wyld-pdp__review-count">Read reviews</a>
          {%- endif -%}
        </div>

        <div class="wyld-pdp__price-row">
          <span class="wyld-pdp__price" id="wyldPdpPrice">{{ current_variant.price | money }}</span>
          {% if has_compare_price %}
            <span class="wyld-pdp__compare">{{ current_variant.compare_at_price | money }}</span>
            <span class="wyld-pdp__discount-badge">Save {{ discount_pct }}%</span>
          {% endif %}
        </div>

        {%- comment -%} Loyalty + replenishment signals (LTV) {%- endcomment -%}
        {%- assign loyalty_points = current_variant.price | divided_by: 100 -%}
        <div class="wyld-pdp__ltv-row">
          <span class="wyld-pdp__ltv-chip">
            <span class="wyld-pdp__ltv-chip-icon">♡</span>
            Earn <strong>{{ loyalty_points }} Wyld Heart</strong> points with this order
          </span>
          <span class="wyld-pdp__ltv-chip wyld-pdp__ltv-chip--muted">
            <span class="wyld-pdp__ltv-chip-icon">↻</span>
            Most customers reorder every 4–6 weeks
          </span>
        </div>

        {% if product.metafields.custom.short_description %}
          <p class="wyld-pdp__short-desc">{{ product.metafields.custom.short_description }}</p>
        {% endif %}

        {%- comment -%} --- VARIANT PICKER --- {%- endcomment -%}
        {% if product.has_only_default_variant == false %}
          <div class="wyld-pdp__variants">
            {%- for option in product.options_with_values -%}
              <span class="wyld-pdp__variant-label">{{ option.name }}: <strong id="wyldPdpVariantValue{{ forloop.index }}">{{ option.selected_value }}</strong></span>
              <div class="wyld-pdp__variant-options">
                {%- for value in option.values -%}
                  <button type="button" class="wyld-pdp__variant-btn {% if value == option.selected_value %}is-active{% endif %}" data-option-index="{{ forloop.parentloop.index0 }}" data-option-value="{{ value | escape }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>
        {% endif %}

        {%- comment -%} --- ADD TO CART (standard Shopify form — Loop will inject subscription UI when installed) --- {%- endcomment -%}
        <form action="/cart/add" method="post" enctype="multipart/form-data" id="wyldPdpForm">
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="wyldPdpVariantId">
          <button type="submit" class="wyld-pdp__atc" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}Add to Cart — {{ current_variant.price | money }}{% else %}Sold Out{% endif %}
          </button>
        </form>

        {%- comment -%} --- TRUST BAR --- {%- endcomment -%}
        <div class="wyld-pdp__trust-bar">
          <div class="wyld-pdp__trust-item">
            <svg class="wyld-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h13l5 5v6h-3a2 2 0 11-4 0H10a2 2 0 11-4 0H3V7zM16 12h5"/></svg>
            <span class="wyld-pdp__trust-text">Free Shipping $75+</span>
          </div>
          <div class="wyld-pdp__trust-item">
            <svg class="wyld-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7l3-7z"/></svg>
            <span class="wyld-pdp__trust-text">30-Day Love-It Promise</span>
          </div>
          <div class="wyld-pdp__trust-item">
            <svg class="wyld-pdp__trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-7 8-13a8 8 0 10-16 0c0 6 8 13 8 13z"/><circle cx="12" cy="9" r="3"/></svg>
            <span class="wyld-pdp__trust-text">Handcrafted in Kelowna BC</span>
          </div>
        </div>

        {%- comment -%} --- BUNDLE UPSELL --- {%- endcomment -%}
        <a href="/collections/bundles" class="wyld-pdp__bundle-card">
          <div class="wyld-pdp__bundle-icon">⊕</div>
          <div class="wyld-pdp__bundle-text">
            <div class="wyld-pdp__bundle-label">Complete Your Routine</div>
            <div class="wyld-pdp__bundle-headline">Pair with our top picks — Save up to 20% on bundles</div>
          </div>
          <div class="wyld-pdp__bundle-arrow">→</div>
        </a>

        {%- comment -%} --- COMPACT TABS (under bundle, right column) --- {%- endcomment -%}
        {% if product.description != blank %}
          <section class="wyld-pdp__rich-section wyld-pdp__rich-section--compact">
            {{ product.description }}
          </section>
        {% endif %}

      </div>
    </div>

  {%- comment -%} ========== CUSTOM RICH SECTIONS PER PRODUCT ========== {%- endcomment -%}
  {% if product.handle == 'organic-ozonated-olive-oil' %}
    {%- comment -%} ===================== 1. EDITORIAL HERO IMAGE + STORY (asymmetric, smaller image, no box bg) ===================== {%- endcomment -%}
    <section style="padding:120px 0;background:var(--wyld-cream,#FAF6EE);">
      <div style="max-width:1320px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:0.85fr 1fr;gap:96px;align-items:center;">
        <div style="position:relative;max-width:480px;">
          <img src="https://cdn.shopify.com/s/files/1/0640/4977/4849/files/Open_ozonated_olive_oil_jar..jpg?v=1755573066&width=1000" alt="Naturally Wyld Ozonated Olive Oil — open jar with olive branch" loading="lazy" style="width:100%;height:auto;display:block;aspect-ratio:4/5;object-fit:cover;filter:sepia(0.55) saturate(1.05) hue-rotate(-18deg) brightness(1.06) contrast(0.96);">
        </div>
        <div style="max-width:480px;">
          <p style="font-size:10px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:var(--wyld-rose,#9A6B65);margin:0 0 24px;">What sets us apart</p>
          <h2 style="font-family:var(--font-serif,'Cormorant Garamond',serif);font-size:clamp(34px,3.8vw,56px);font-weight:400;color:var(--wyld-ink,#1F1B17);line-height:1.08;margin:0 0 36px;letter-spacing:-0.015em;">A balm <em style="font-style:italic;color:var(--wyld-rose,#9A6B65);">trusted</em> for pure potency and skin transformation.</h2>
          <p style="font-size:15px;line-height:1.85;font-weight:300;color:var(--wyld-ink-soft,#2C2620);margin:0 0 20px;">Organic, cold-pressed extra-virgin olive oil meets pure medical-grade ozone — a luxurious, oxygen-rich balm with a creamy gel-like consistency.</p>
          <p style="font-size:15px;line-height:1.85;font-weight:300;color:var(--wyld-ink-soft,#2C2620);margin:0 0 20px;">Solid at room temperature, it melts on contact. The naturally potent aroma — often compared to the air after a lightning storm — comes from the ozone itself, signaling authentic infusion and exceptional purity.</p>
          <p style="font-size:15px;line-height:1.85;font-weight:300;color:var(--wyld-ink-soft,#2C2620);margin:0;">Handcrafted in small batches in British Columbia. Flash-frozen. Trusted worldwide.</p>
        </div>
      </div>
    </section>

    {%- comment -%} ===================== 1B. MADE BY HAND — authenticity moat (vs PurO3 outsourcing competitors) ===================== {%- endcomment -%}
    <section style="padding:120px 0;background:var(--wyld-cream-warm,#F0EAD8);border-top:1px solid rgba(195,194,174,0.4);">
      <div style="max-width:1240px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <p style="font-size:10px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:var(--wyld-rose,#9A6B65);margin:0 0 24px;">Made by hand</p>
          <h2 style="font-family:var(--font-serif,'Cormorant Garamond',serif);font-size:clamp(32px,3.4vw,48px);font-weight:400;color:var(--wyld-ink,#1F1B17);line-height:1.1;margin:0 0 28px;letter-spacing:-0.015em;">Hand-crafted in our own <em style="font-style:italic;color:var(--wyld-rose,#9A6B65);">Kelowna lab</em>.</h2>
          <p style="font-size:15px;line-height:1.85;font-weight:300;color:var(--wyld-ink-soft,#2C2620);margin:0 0 18px;">Every jar of Naturally Wyld Ozonated Olive Oil is hand-crafted in our Kelowna, BC facility — never outsourced, never mass-produced. We control every step: sourcing organic cold-pressed olive oil, infusing it with medical-grade ozone in small batches, and flash-freezing each jar to lock in potency.</p>
          <p style="font-size:15px;line-height:1.85;font-weight:300;color:var(--wyld-ink-soft,#2C2620);margin:0 0 18px;">We've been doing this for over 10 years. Every bottle on your shelf was poured by us, sealed by us, shipped by us. No big-batch factories. No anonymous contract manufacturers. Just a small team in British Columbia, making the kind of oil we'd put on our own family.</p>
          <p style="font-family:var(--font-serif,'Cormorant Garamond',serif);font-style:italic;font-size:15px;color:var(--wyld-stone,#5F574D);margin:0;line-height:1.7;">Ozone-infused olive oil has been used in skincare for over a century — once sold by famed inventor Nikola Tesla, and recommended by veterinarians worldwide today.</p>
        </div>
        <div style="position:relative;">
          <img src="https://cdn.shopify.com/s/files/1/0640/4977/4849/files/Ozonated_Olive_Oil_Showing_Product.jpg?v=1755573980&width=900" alt="Hand-poured Naturally Wyld Ozonated Olive Oil — spoon scooping the cream from an open jar in our Kelowna lab" loading="lazy" style="width:100%;height:auto;display:block;aspect-ratio:4/5;object-fit:cover;">
        </div>
      </div>
    </section>

    {%- comment -%} ===================== 2. THE PROCESS — Editorial numbered list, no boxes ===================== {%- endcomment -%}
    <section style="padding:120px 0;background:var(--wyld-cream,#FAF6EE);border-top:1px solid rgba(195,194,174,0.4);">
      <div style="max-width:1320px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1fr 1.4fr;gap:96px;">
        <div style="position:sticky;top:120px;align-self:start;">
          <p style="font-size:10px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:var(--wyld-rose,#9A6B65);margin:0 0 24px;">The process</p>
          <h2 style="font-family:var(--font-serif,'Cormorant Garamond',serif);font-size:clamp(34px,3.8vw,56px);font-weight:400;color:var(--wyld-ink,#1F1B17);line-height:1.08;margin:0 0 28px;letter-spacing:-0.015em;">Crafted with <em style="font-style:italic;color:var(--wyld-rose,#9A6B65);">intention</em>.</h2>
          <p style="font-size:15px;line-height:1.85;font-weight:300;color:var(--wyld-ink-soft,#2C2620);margin:0;max-width:380px;">Six commitments that go into every jar. Quality-assured. Engineered to outperform.</p>
        </div>
        <div>
          {%- assign reasons_titles = 'Certified organic|Maximum ozone saturation|Flash-frozen freshness|Medical-grade oxygen|Premium glass packaging|Handcrafted in Canada' | split: '|' -%}
          {%- assign reasons_bodies = 'One hundred percent cold-pressed extra-virgin oils. Nothing else added, nothing diluted.|Low-temperature infusion to fully saturate every drop with ozone — never rushed.|Potency locked in for up to a year at room temperature, with no preservatives.|Only lab-certified, ultra-pure oxygen feeds our ozone generators.|BPA-free amber jars protect the oil from light degradation, preserving every active compound.|Small-batch quality you can trust, made right here in British Columbia.' | split: '|' -%}
          {%- for i in (0..5) -%}
            <div style="display:grid;grid-template-columns:80px 1fr;gap:32px;padding:36px 0;{%- unless forloop.last -%}border-bottom:1px solid rgba(195,194,174,0.5);{%- endunless -%}">
