<script>
  // Sticky ATC: appear when main ATC scrolls out of view
  (function() {
    var bar = document.getElementById('wyldPdpStickyAtc');
    var atc = document.querySelector('.wyld-pdp__atc');
    if (!bar || !atc) return;
    if (!('IntersectionObserver' in window)) return;
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        // When main ATC is OFF screen, show sticky bar
        if (e.isIntersecting) {
          bar.classList.remove('is-visible');
          bar.setAttribute('aria-hidden', 'true');
        } else if (e.boundingClientRect.top < 0) {
          // ATC has scrolled above viewport — show sticky
          bar.classList.add('is-visible');
          bar.setAttribute('aria-hidden', 'false');
        } else {
          // ATC is below viewport (not yet scrolled to) — hide sticky
          bar.classList.remove('is-visible');
          bar.setAttribute('aria-hidden', 'true');
        }
      });
    }, { threshold: 0 });
    obs.observe(atc);
  })();

  // Gallery: Saie pattern — thumb click swaps hero on desktop; on mobile scroll-snap carousel + dots
  (function() {
    var main = document.getElementById('wyldPdpMain');
    var thumbs = document.querySelectorAll('.wyld-pdp__thumb');
    var dots = document.querySelectorAll('.wyld-pdp__dot');
    var images = document.querySelectorAll('.wyld-pdp__main-img');
    if (!main || images.length === 0) return;

    function setActive(idx) {
      thumbs.forEach(function(t, i) {
        var on = i === idx;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      dots.forEach(function(d, i) {
        d.classList.toggle('is-active', i === idx);
      });
    }

    function isMobile() {
      return window.matchMedia('(max-width: 900px)').matches;
    }

    function goTo(idx) {
      if (idx < 0 || idx >= images.length) return;
      if (isMobile()) {
        var target = images[idx];
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      } else {
        // Desktop: hide all except target
        images.forEach(function(img, i) {
          img.style.display = i === idx ? 'block' : 'none';
        });
      }
      setActive(idx);
    }

    // Desktop: start with only first image visible
    if (!isMobile()) {
      images.forEach(function(img, i) { img.style.display = i === 0 ? 'block' : 'none'; });
    }

    thumbs.forEach(function(t, i) {
      t.addEventListener('click', function() { goTo(i); });
    });
    dots.forEach(function(d, i) {
      d.addEventListener('click', function() { goTo(i); });
    });

    // Mobile: detect scroll position to update dot active state
    var scrollTimer;
    main.addEventListener('scroll', function() {
      if (!isMobile()) return;
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function() {
        var scrollLeft = main.scrollLeft;
        var slideWidth = main.clientWidth;
        var activeIdx = Math.round(scrollLeft / slideWidth);
        setActive(activeIdx);
      }, 80);
    });

    // Resize: re-apply correct display mode
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        if (isMobile()) {
          images.forEach(function(img) { img.style.display = ''; });
        } else {
          var activeThumb = document.querySelector('.wyld-pdp__thumb.is-active');
          var idx = activeThumb ? parseInt(activeThumb.dataset.index, 10) : 0;
          images.forEach(function(img, i) { img.style.display = i === idx ? 'block' : 'none'; });
        }
      }, 120);
    });
  })();


  // Variant picker (basic — real implementation should swap variant id + price)
  (function() {
    var btns = document.querySelectorAll('.wyld-pdp__variant-btn');
    btns.forEach(function(b) {
      b.addEventListener('click', function() {
        var idx = b.dataset.optionIndex;
        document.querySelectorAll('.wyld-pdp__variant-btn[data-option-index="' + idx + '"]').forEach(function(x) {
          x.classList.remove('is-active');
        });
        b.classList.add('is-active');
        var v = document.getElementById('wyldPdpVariantValue' + (parseInt(idx) + 1));
        if (v) v.textContent = b.dataset.optionValue;
        // TODO: wire variant ID swap + price update via Shopify product JSON endpoint
      });
    });
  })();

  // H5 → Tabs converter — SEO-SAFE: preserves H5 elements in DOM + adds ARIA roles.
  // Crawlers still see heading hierarchy. Hidden tab panels are accessible to screen readers.
  (function() {
    var richSection = document.querySelector('.wyld-pdp__rich-section');
    if (!richSection) return;
    var h5s = Array.from(richSection.querySelectorAll('h5'));
    if (h5s.length < 2) return; // need at least 2 H5s to make tabs

    // Collect tab labels + content groups (group each H5 + following siblings until next H5)
    var groups = h5s.map(function(h5) {
      var contents = [];
      var sib = h5.nextElementSibling;
      while (sib && sib.tagName !== 'H5') {
        contents.push(sib);
        sib = sib.nextElementSibling;
      }
      return { h5: h5, label: h5.textContent.trim(), contents: contents };
    });

    if (groups.length === 0) return;

    // Build tab nav + panels — KEEP H5 inside each panel (visually hidden via class) for SEO
    var tabsWrap = document.createElement('div');
    tabsWrap.className = 'wyld-pdp__tabs';
    var nav = document.createElement('div');
    nav.className = 'wyld-pdp__tabs-nav';
    nav.setAttribute('role', 'tablist');
    var panelsHost = document.createElement('div');
    panelsHost.className = 'wyld-pdp__tabs-panels';

    groups.forEach(function(g, i) {
      var tabId = 'wyld-pdp-tab-' + i;
      var panelId = 'wyld-pdp-panel-' + i;
      var accBtnId = 'wyld-pdp-acc-' + i;

      // Desktop tab button (all start CLOSED — no auto-open)
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'wyld-pdp__tab-btn';
      btn.textContent = g.label;
      btn.id = tabId;
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-controls', panelId);
      btn.setAttribute('aria-selected', 'false');
      btn.dataset.tabIndex = i;
      nav.appendChild(btn);

      // Mobile accordion button (precedes its panel) — all start CLOSED
      var accBtn = document.createElement('button');
      accBtn.type = 'button';
      accBtn.className = 'wyld-pdp__accordion-btn';
      accBtn.textContent = g.label;
      accBtn.id = accBtnId;
      accBtn.setAttribute('aria-controls', panelId);
      accBtn.setAttribute('aria-expanded', 'false');
      accBtn.dataset.tabIndex = i;
      panelsHost.appendChild(accBtn);

      // Panel — all start CLOSED
      var panel = document.createElement('div');
      panel.className = 'wyld-pdp__tab-panel';
      panel.id = panelId;
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabId);
      panel.dataset.tabIndex = i;

      // Note: H5 was just a tab MARKER (not real heading hierarchy), so we remove it entirely.
      // The h2/h3 inside the tab content is the real SEO hierarchy and stays intact.

      // Move content into panel
      g.contents.forEach(function(node) {
        panel.appendChild(node);
      });
      panelsHost.appendChild(panel);
    });

    tabsWrap.appendChild(nav);
    tabsWrap.appendChild(panelsHost);

    // Insert tabs widget where the first H5 was; remove the original H5s
    var firstH5 = h5s[0];
    firstH5.parentNode.insertBefore(tabsWrap, firstH5);
    h5s.forEach(function(h5) { h5.remove(); });

    function activate(idx) {
      nav.querySelectorAll('.wyld-pdp__tab-btn').forEach(function(b) {
        var on = b.dataset.tabIndex === idx;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panelsHost.querySelectorAll('.wyld-pdp__accordion-btn').forEach(function(b) {
        var on = b.dataset.tabIndex === idx;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      panelsHost.querySelectorAll('.wyld-pdp__tab-panel').forEach(function(p) {
        p.classList.toggle('is-active', p.dataset.tabIndex === idx);
      });
    }

    // Desktop tab click — toggle (click active tab again to close)
    nav.addEventListener('click', function(e) {
      var btn = e.target.closest('.wyld-pdp__tab-btn');
      if (!btn) return;
      var isOpen = btn.classList.contains('is-active');
      if (isOpen) {
        // Collapse: nothing active
        nav.querySelectorAll('.wyld-pdp__tab-btn').forEach(function(b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        panelsHost.querySelectorAll('.wyld-pdp__tab-panel').forEach(function(p) {
          p.classList.remove('is-active');
        });
        panelsHost.querySelectorAll('.wyld-pdp__accordion-btn').forEach(function(b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-expanded', 'false');
        });
      } else {
        activate(btn.dataset.tabIndex);
      }
    });

    // Mobile accordion click — toggle behavior (allow closing the active one)
    panelsHost.addEventListener('click', function(e) {
      var btn = e.target.closest('.wyld-pdp__accordion-btn');
      if (!btn) return;
      var idx = btn.dataset.tabIndex;
      var isOpen = btn.classList.contains('is-active');
      if (isOpen) {
        // Collapse all
        panelsHost.querySelectorAll('.wyld-pdp__accordion-btn').forEach(function(b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-expanded', 'false');
        });
        panelsHost.querySelectorAll('.wyld-pdp__tab-panel').forEach(function(p) {
          p.classList.remove('is-active');
        });
      } else {
        activate(idx);
      }
    });
  })();
</script>

